{
  "name": "papilles-et-mami",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "remix build",
    "dev": "remix dev --manual",
    "format": "prettier --write .",
    "format:repo": "npm run format && npm run lint -- --fix",
    "lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
    "start": "remix-serve ./build/index.js",
    "typecheck": "tsc",
    "db:reset": "rm -rf prisma/papilles_et_mami.db && npm run db:migrate && npm run db:seed",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/client": "^6.19.3",
    "@remix-run/css-bundle": "^2.17.5",
    "@remix-run/node": "^2.17.5",
    "@remix-run/react": "^2.17.5",
    "@remix-run/serve": "^2.17.5",
    "@remixicon/react": "^4.9.0",
    "clsx": "^2.1.1",
    "i18next": "^23.16.8",
    "i18next-browser-languagedetector": "^8.3.0",
    "i18next-fs-backend": "^2.6.11",
    "i18next-http-backend": "^3.0.6",
    "isbot": "^4.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.7.4",
    "remix-auth": "^3.7.0",
    "remix-auth-google": "^2.0.0",
    "remix-i18next": "^6.4.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@flydotio/dockerfile": "^0.5.9",
    "@playwright/test": "^1.61.1",
    "@remix-run/dev": "^2.17.5",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^6.7.4",
    "@typescript-eslint/parser": "^6.7.4",
    "autoprefixer": "^10.6.2",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-unused-imports": "^3.2.0",
    "postcss": "^8.5.32",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "qs": "6.17.1",
    "tar": "7.5.22",
    "toml": "5.0.1"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
